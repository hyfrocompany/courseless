{
  "name": "courseless",
  "version": "0.1.1",
  "description": "Stop taking courses. Start doing things.",
  "main": "./out/main/index.js",
  "author": "Courseless",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "seeds": "tsx scripts/generate-seeds.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "tsx scripts/make-icons.mts",
    "pack:mac": "electron-vite build && electron-builder --mac --publish never",
